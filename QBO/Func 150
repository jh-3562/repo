// ============================================================================
// CONSTANTS
// ============================================================================

const ABRIBUS_TEMPLATE_ID = "87cbdb19-0ad7-45ce-80d1-34d3a00dc174";

const DEFAULT_TEAM_VALUE = "Sans équipe";

const ALL_ABRIBUS_API_FILTER = [
    {
        key: "FORMLAYOUTNAME",
        operator: "EQUALS",
        value: "ABRIBUS",
        type: "TEXT",
    }
];

const ABRIBUS_WITH_TEAM_API_FILTER = [
    {
        key: "FORMLAYOUTNAME",
        operator: "EQUALS",
        value: "ABRIBUS",
        type: "TEXT",
    },
    {
        key: "EquipeAbribus",
        operator: "EXISTS",
        type: "TEXT"
    },
];

// ============================================================================
// UTILITIES
// ============================================================================

const createOrUpdateElement = (id, tag, style, innerHTML = "") => {
    let element = document.getElementById(id);
    if (!element) {
        element = document.createElement(tag);
        element.id = id;
        document.body.appendChild(element);
    }
    element.style = style;
    element.innerHTML = innerHTML;
    return element;
};

const showErrorBanner = (errorMessage) => {
    const errorBanner = createOrUpdateElement(
        "errorBanner",
        "div",
        `
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: auto;
      min-width: 300px;
      height: 50px;
      background-color: white;
      color: black;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      border-radius: 5px;
      padding: 0 20px;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
    `,
        `
<div style="margin-right: 10px; color: red;">&#x26A0;</div><div>${errorMessage}</div>
<div id="errorBannerProgress" style="position: absolute; bottom: 0; left: 0; background-color: red; height: 5px; width: 0%;"></div>
    `
    );
    let progressElement = document.getElementById("errorBannerProgress");
    let width = 0;
    let interval = setInterval(() => {
        if (width >= 100) {
            clearInterval(interval);
            errorBanner.style.display = "none";
        } else {
            width++;
            progressElement.style.width = width + "%";
        }
    }, 55); // La barre progresse sur 5 secondes
};

