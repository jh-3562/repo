const getDocumentIDs = async (apiFilters) => {
    try {
        const response = await api({ local: true }).post("document/id/filter", {
            filters: apiFilters,
        });

        return response?.data?.ids || [];
    } catch (error) {
        console.error("Failed to fetch document IDs:", error);
        return [];
    }
};

const getDocuments = async (documentIDs) => {
    try {
        const response = await api({ local: true }).post("document/id", {
            ids: documentIDs,
        });

        return response?.data?.documents || [];
    } catch (error) {
        console.error("Failed to fetch documents:", error);
        return [];
    }
};

const updateDocuments = async (documentsToUpdate) => {
    try {
        const response = await api({ local: true }).put("document/Many", {
            documents: documentsToUpdate,
        });

        return response?.data?.documents || [];
    } catch (error) {
        console.error("Failed to update documents:", error);
        return [];
    }
};

// ============================================================================
// BUSINESS LOGIC
// ============================================================================

const identifyAbribusWithoutTeam = (allIDs, withTeamIDs) => {
    const withTeamSet = new Set(withTeamIDs);
    return allIDs.filter(id => !withTeamSet.has(id));
};

const hasAbribusToUpdate  = (abribusWithoutTeamIDs) => {
    if (abribusWithoutTeamIDs.length === 0) {
        showSuccessBanner("Aucun abribus à modifier");
        return false;
    }
    return true;
};

const prepareTeamAssignment = (document) => {
    return {
        data: JSON.stringify({ "EquipeAbribus": DEFAULT_TEAM_VALUE }),
        status: document.status,
        active: true,
        template: { templateId: ABRIBUS_TEMPLATE_ID },
        documentID: document.documentID
    };
}

const assignDefaultTeam = async (abribusWithoutTeamData) => {
    const documentsToUpdate = abribusWithoutTeamData.map(data => prepareTeamAssignment(data));

    await updateDocuments(documentsToUpdate);
}

const main = async () => {
    try {
        showSuccessBanner("Traitement en cours...");

        const [allAbribusIDs, abribusWithTeamIDs] = await Promise.all([
            getDocumentIDs(ALL_ABRIBUS_API_FILTER),
            getDocumentIDs(ABRIBUS_WITH_TEAM_API_FILTER)
        ]);

        const abribusWithoutTeamIDs = identifyAbribusWithoutTeam(allAbribusIDs, abribusWithTeamIDs);

        if (!hasAbribusToUpdate (abribusWithoutTeamIDs)) return;
        
        const abribusWithoutTeamData = await getDocuments(abribusWithoutTeamIDs);

        await assignDefaultTeam(abribusWithoutTeamData);

        showSuccessBanner(`${abribusWithoutTeamIDs.length} abribus ${abribusWithoutTeamIDs.length > 1 ? 'ont été modifiés' : 'a été modifié'}`);

    } catch (error) {
        console.log("Erreur", "Une erreur est survenue : " + error.message);
        showErrorBanner("Une erreur est survenue.");
    }
}

main()
