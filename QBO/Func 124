const getDocumentsIDsByFilters = async (apiFilters) => {
    try {
        const response = await api({ local: true }).post("document/id/filter", {
            filters: apiFilters,
        });

        return response?.data?.ids || [];
    } catch (error) {
        console.error("Failed to fetch document IDs:", error);
        return [];
    }
};

const getDocumentsByIDs = async (documentIDs) => {
    try {
        const response = await api({ local: true }).post("document/id", {
            ids: documentIDs,
        });
        return response?.data?.documents || [];
    } catch (error) {
        console.error("Failed to fetch documents:", error);
        return [];
    }
};

const createDocuments = async (documentsToCreate) => {
    try {
        const response = await api({ local: true }).post("document/many", {
            documents: documentsToCreate,
        });

        return response?.data?.docs || [];
    } catch (error) {
        console.error("Failed to create documents:", error);
        return [];
    }
};

const updateDocument = async (documentToUpdate) => {
    try {
        const response = await api({ local: true }).put("document", {
            document: documentToUpdate,
        });

        return response?.data?.document || null;
    } catch (error) {
        console.error("Failed to update document:", error);
        return null;
    }
};

// ============================================================================
// DATE CALCULATION
// ============================================================================

const calculateDueDate = (startDate, slaDelay) => {
    if (!startDate) {
        return "";
    }

    const dueDate = new Date(startDate);
    const delay = SLA_DELAYS[slaDelay] || DEFAULT_SLA_DELAY;

    switch (delay.unit) {
        case "hours":
            dueDate.setHours(dueDate.getHours() + delay.value);
            break;
        case "days":
            dueDate.setDate(dueDate.getDate() + delay.value);
            break;
        case "months":
            dueDate.setMonth(dueDate.getMonth() + delay.value);
            break;
    }

    return dueDate.toISOString().substring(0, 19);
};

// ============================================================================
// BUSINESS LOGIC - PLANNING
// ============================================================================

const getPlanningID = async () => {
    const apiFilters = [
        {
            key: "FORMLAYOUTNAME",
            operator: "EQUALS",
            value: PLANNING_TEMPLATE_NAME,
            type: "TEXT",
        },
        {
            key: "STATUS",
            operator: "EQUALS",
            value: PLANNING_STATUS,
            type: "TEXT",
        },
    ];

    const ids = await getDocumentsIDsByFilters(apiFilters);
    return ids[0] || null;
};

const getPlanningData = async (planningID) => {
    const documents = await getDocumentsByIDs([planningID]);
    return documents[0] || null;
};

const extractPlanningData = (planningData) => {
    const data = JSON.parse(planningData.data);

    const optimDate = data[PLANNING_KEYS.OPTIM_DATE] || null;
    const slaDelay = data[PLANNING_KEYS.SLA_DELAY] || null;
    const dueDate = calculateDueDate(optimDate, slaDelay);

    return {
        ...data,
        [PLANNING_KEYS.DUE_DATE]: dueDate,
        number: planningData.number
    };
};

const updatePlanningStatus = async (planningID) => {
    const documentToUpdate = {
        status: FINAL_PLANNING_STATUS,
        active: true,
        template: { templateId: PLANNING_TEMPLATE_ID },
        documentID: planningID,
    };

    await updateDocument(documentToUpdate);
};

// ============================================================================
// BUSINESS LOGIC - BUS SHELTERS
// ============================================================================

const buildBusShelterFilters = (planning) => {
    const filters = [
        {
            key: "FORMLAYOUTNAME",
            operator: "EQUALS",
            value: BUS_SHELTER_TEMPLATE_NAME,
            type: "TEXT",
        },
        {
            key: "STATUS",
            operator: "EQUALS",
            value: BUS_SHELTER_STATUS,
            type: "TEXT",
        },
    ];

    const teams = planning[PLANNING_KEYS.TEAM];
    if (teams) {
        filters.push({
            key: BUS_SHELTER_KEYS.TEAM,
            operator: "IN",
            value: teams,
            type: "TEXT",
        });
    }

    const districts = planning[PLANNING_KEYS.DISTRICT];
    if (districts) {
        filters.push({
            key: BUS_SHELTER_KEYS.DISTRICT,
            operator: "IN",
            value: districts,
            type: "TEXT",
        });
    }

    const partners = planning[PLANNING_KEYS.PARTNER];
    if (partners) {
        filters.push({
            key: BUS_SHELTER_KEYS.PARTNER,
            operator: "IN",
            value: partners,
            type: "TEXT",
        });
    }

    const models = planning[PLANNING_KEYS.MODEL];
    if (models) {
        filters.push({
            key: BUS_SHELTER_KEYS.MODEL,
            operator: "IN",
            value: models,
            type: "TEXT",
        });
    }

    const special = planning[PLANNING_KEYS.SPECIAL];
    if (special) {
        filters.push({
            key: BUS_SHELTER_KEYS.SPECIAL,
            operator: "CONTAINS",
            value: special,
            type: "TEXT",
        });
    }

    return filters;
};

const getBusShelterIDs = async (planning) => {
    const filters = buildBusShelterFilters(planning);
    console.log("Filters applied:", filters);
    return await getDocumentsIDsByFilters(filters);
};

const getBusShelters = async (busShelterIDs) => {
    if (busShelterIDs.length === 0) {
        return [];
    }
    return await getDocumentsByIDs(busShelterIDs);
};

// ============================================================================
// BUSINESS LOGIC - INTERVENTIONS
// ============================================================================

const prepareInterventionData = (busShelter, planning) => {
    const busShelterData = JSON.parse(busShelter.data);

    const interventionData = {
        ...busShelterData,
        CommandDate: planning[PLANNING_KEYS.OPTIM_DATE],
        TypeIntervention: planning[PLANNING_KEYS.INTERVENTION_TYPE],
        SousCatégorie1: planning[PLANNING_KEYS.SUB_CATEGORY],
        DélaiSLA: planning[PLANNING_KEYS.SLA_DELAY],
        DateDue: planning[PLANNING_KEYS.DUE_DATE],
        NumPlanification: planning.number,
    };

    return {
        data: JSON.stringify(interventionData),
        status: INTERVENTION_STATUS,
        active: true,
        template: { templateId: INTERVENTION_TEMPLATE_ID }
    };
};

const createInterventions = async (busShelters, planning) => {
    if (busShelters.length === 0) {
        return [];
    }

    const interventionsToCreate = busShelters.map(shelter =>
        prepareInterventionData(shelter, planning)
    );

    const createdInterventions = await createDocuments(interventionsToCreate);

    return createdInterventions;
};

// ============================================================================
// EXECUTION
// ============================================================================

const main = async () => {
    try {
        // Confirmation avant de lancer
        const confirmed = await showPopupConfirmation(
            "Génération des interventions",
            "<p>Voulez-vous générer les interventions pour la dernière planification <strong>Soumise</strong> ?</p>",
            "Oui, continuer",
            "Annuler"
        );

        if (!confirmed) {
            showErrorBanner("Opération annulée.");
            return;
        }

        showPopupLoading("Traitement en cours...");

        const planningID = await getPlanningID();

        if (!planningID) {
            hidePopupLoading();
            console.log("No planning document found");
            showErrorBanner("Aucune planification au statut \"Soumise\" n'a été trouvée.");
            return;
        }

        console.log(`planningID`, planningID);

        const planningData = await getPlanningData(planningID);

        if (!planningData) {
            hidePopupLoading();
            console.log("Failed to retrieve planning data");
            showErrorBanner("Impossible de récupérer les données de la planification.");
            return;
        }

        const planning = extractPlanningData(planningData);

        console.log(`planning`, planning);

        const busShelterIDs = await getBusShelterIDs(planning);
        console.log(`Found ${busShelterIDs.length} matching bus shelters`);

        if (busShelterIDs.length === 0) {
            hidePopupLoading();
            console.log("No matching bus shelters found for the criteria");
            showErrorBanner("Aucun abribus ne correspond aux critères de la planification.");
            return;
        }

        const busShelters = await getBusShelters(busShelterIDs);

        const createdInterventions = await createInterventions(busShelters, planning);
        console.log(`Successfully created ${createdInterventions.length} interventions`);

        await updatePlanningStatus(planningID);

        hidePopupLoading();
        showSuccessBanner(`Opération réussie : ${createdInterventions.length} interventions créées.`);

    } catch (error) {
        console.error("Error occurred:", error.message);
        hidePopupLoading();
        showErrorBanner("Une erreur est survenue.");
    }
};

main();

