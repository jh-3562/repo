const createOrUpdateElement = (id, tag, style, innerHTML = "") => {
    let element = document.getElementById(id);
    if (!element) {
        element = document.createElement(tag);
        element.id = id;
        document.body.appendChild(element);
    }
    element.style = style;
    element.innerHTML = innerHTML;
    return element;
};

