// Function #124 - Fetch submitted planning and create interventions for matching bus shelters
// Retrieves planning document with status "Soumise", filters bus shelters based on criteria,
// and calculates due dates based on SLA

// ============================================================================
// CONSTANTS
// ============================================================================

const PLANNING_TEMPLATE_ID = "6a2ee73e-dabc-4bc4-9ceb-d2b38383fb52";
const PLANNING_TEMPLATE_NAME = "PLANIFICATION";
const PLANNING_STATUS = "Soumise";
const FINAL_PLANNING_STATUS = 'À planifier';

const BUS_SHELTER_TEMPLATE_NAME = "ABRIBUS";
const BUS_SHELTER_STATUS = "Actif";

const INTERVENTION_TEMPLATE_ID = "F7B9A59A-E708-45C4-B786-2A5130CFEE2B";
const INTERVENTION_STATUS = "Non-assignée";

const PLANNING_KEYS = {
    // Filtre
    TEAM: "EquipeFiltre",
    DISTRICT: "ArrondissementFiltre",
    PARTNER: "PartenaireFiltre",
    MODEL: "ModeleFiltre",
    SPECIAL: "Abribus_Special",

    OPTIM_DATE: "DateOptim",
    SLA_DELAY: "DélaiSLA",
    DUE_DATE: "DateDue",
    INTERVENTION_TYPE: "TypeIntervention",
    SUB_CATEGORY: "SousCatégorie1",
};

const BUS_SHELTER_KEYS = {
    // Filtre
    TEAM: "EquipeAbribus",
    DISTRICT: "Arrondissement",
    PARTNER: "Partenaire",
    MODEL: "Abribus_Modele",
    SPECIAL: "Abribus_Special",
};

const SLA_DELAYS = {
    "4h": { unit: "hours", value: 4 },
    "12h": { unit: "hours", value: 12 },
    "24h": { unit: "days", value: 1 },
    "48h": { unit: "days", value: 2 },
    "72h": { unit: "days", value: 3 },
    "4 jours": { unit: "days", value: 4 },
    "7 jours": { unit: "days", value: 7 },
    "1 mois": { unit: "months", value: 1 },
    "3 mois": { unit: "months", value: 3 },
};

const DEFAULT_SLA_DELAY = { unit: "days", value: 1 };

