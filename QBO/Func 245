const getToken = () => {
  const keys = ['token', 'access_token', 'accessToken', 'jwt', 'JWT', 'authToken', 'AUTH_TOKEN'];
  for (const k of keys) {
    const v = localStorage.getItem(k) || sessionStorage.getItem(k);
    if (v && String(v).trim()) return String(v).trim();
  }
  return '';
};

const imprimerInterventionPDF = async (formId) => {
  const apiUrl = `${window.location.origin}/api/document/download/Intervention/PDF/${encodeURIComponent(formId)}`;

  const token = getToken();
  if (!token) throw new Error('Token manquant (localStorage/sessionStorage)');

  const res = await fetch(apiUrl, {
    method: 'GET',
    credentials: 'include',
    headers: {
      Authorization: `Bearer ${token}`,
      Accept: 'application/json, application/pdf'
    }
  });

  if (!res.ok) throw new Error(`Erreur PDF (${res.status})`);

  const ct = (res.headers.get('content-type') || '').toLowerCase();

  if (ct.includes('application/pdf')) {
    const blob = await res.blob();
    const blobUrl = URL.createObjectURL(blob);
    window.open(blobUrl, '_blank', 'noopener');
    setTimeout(() => { try { URL.revokeObjectURL(blobUrl); } catch {} }, 30000);
    return true;
  }

  const data = await res.json();
  const fileUrl = String(data?.fileUrl || '').trim();
  if (!fileUrl) throw new Error('fileUrl manquant');

  const fullUrl = fileUrl.startsWith('http')
    ? fileUrl
    : `${window.location.origin}${fileUrl.startsWith('/') ? '' : '/'}${fileUrl}`;

  window.open(fullUrl, '_blank', 'noopener');
  return true;
};

(async () => {
  try {
    const formId = String(docData?.FORMID || '').trim();
    if (!formId) throw new Error('FORMID manquant');

    await imprimerInterventionPDF(formId);
