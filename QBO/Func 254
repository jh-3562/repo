// Keep collection field indexes stable for the backend's flattened data format.
const collectionFieldIndexes = {
  Mapping: {
    Role: 1,
    Arrondissement: 2,
    GeocodeKey: 3,
  },
  Geocode: {
    GeocodeKey: 1,
    GeoJson: 2,
