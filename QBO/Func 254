// Replace mappings for the selected identities and retain only referenced geocodes.
const buildUpdatedMappingAndGeocode = (
  existingData,
  role,
  arrondissements,
  geoJson,
  address,
  latitude,
  longitude,
) => {
  const existingMapping = parseDataCollection(existingData, "Mapping").map(
    (row) => excludeKeys(row, ["Arrondissement_Liée"]),
  );
  const existingGeocodes = parseDataCollection(existingData, "Geocode");

  if (arrondissements.length === 0) {
    return { mapping: existingMapping, geocode: existingGeocodes };
  }

  const geocodeKey = createUniqueGeocodeKey(existingGeocodes);
  const mappingToAdd = arrondissements.map((currentArrondissement) => ({
    Role: role,
    Arrondissement: currentArrondissement,
    GeocodeKey: geocodeKey,
  }));
  const replacedIdentities = new Set(mappingToAdd.map(getMappingIdentity));
  const mapping = [
    ...existingMapping.filter(
      (row) => !replacedIdentities.has(getMappingIdentity(row)),
    ),
    ...mappingToAdd,
  ];
  const referencedGeocodeKeys = new Set(
    mapping.map((row) => String(row?.GeocodeKey ?? "")).filter(Boolean),
  );
  const geocodeByKey = new Map();

  existingGeocodes.forEach((row) => {
    const key = String(row?.GeocodeKey ?? "");
    if (referencedGeocodeKeys.has(key)) {
      geocodeByKey.set(key, row);
    }
  });

  geocodeByKey.set(geocodeKey, {
    GeocodeKey: geocodeKey,
    GeoJson: JSON.stringify(geoJson),
    Adresse: address,
    Latitude: latitude,
    Longitude: longitude,
  });

  return { mapping, geocode: [...geocodeByKey.values()] };
};

