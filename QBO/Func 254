// Resolve the depot address to the [latitude, longitude] format used internally.
const geocodeAddress = (address) =>
  new Promise((resolve, reject) => {
    if (!address || String(address).trim() === "") {
      reject(new Error("AdresseDepart est vide."));
      return;
    }

    if (typeof google === "undefined" || !google?.maps?.Geocoder) {
      reject(new Error("Google Maps Geocoder n'est pas disponible."));
      return;
    }

    const geocoder = new google.maps.Geocoder();
    geocoder.geocode({ address: String(address).trim() }, (results, status) => {
      if (status !== "OK" || !Array.isArray(results) || results.length === 0) {
        reject(
          new Error(
            `Geocoding impossible pour AdresseDepart (status: ${status}).`,
          ),
        );
        return;
      }

      const location = results[0]?.geometry?.location;
      if (
        !location ||
        typeof location.lat !== "function" ||
        typeof location.lng !== "function"
      ) {
        reject(new Error("Coordonnées absentes dans la réponse de géocodage."));
        return;
      }

      resolve([String(location.lat()), String(location.lng())]);
    });
  });

// Request OSRM travel durations, converting coordinates to OSRM's lon,lat order.
const buildOsrmTimeMatrix = async (locations) => {
  if (!Array.isArray(locations) || locations.length === 0) {
    throw new Error(
      "Au moins une localisation est requise pour la matrice OSRM.",
    );
  }

  const coordinates = locations
    .map((location, index) => {
      if (!Array.isArray(location) || location.length < 2) {
        throw new Error(`Localisation invalide à l'index ${index}.`);
      }

      const latitude = Number(location[0]);
      const longitude = Number(location[1]);
      if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
        throw new Error(`Coordonnées invalides à l'index ${index}.`);
      }

      return `${longitude},${latitude}`;
    })
    .join(";");

  const query = new URLSearchParams({
    annotations: "duration",
    approaches: locations.map(() => "curb").join(";"),
  });
  const endpoint = `${OSRM_BASE_URL.replace(/\/+$/, "")}/table/v1/${OSRM_PROFILE}/${coordinates}?${query}`;
  console.log("[OSRM Table] Request", {
    endpoint,
    locationCount: locations.length,
    locations,
  });
  const response = await api({ local: true }).post(
    "external",
    {
      Method: "GET",
      Url: endpoint,
    },
    { validErrors: [400] },
  );
  console.log("[OSRM Table] Response", {
    status: response?.status,
    data: response?.data,
  });
  const result = response?.data;
  if (
    result?.code !== "Ok" ||
    !Array.isArray(result?.durations) ||
    result.durations.length !== locations.length
  ) {
    throw new Error(
      `Matrice OSRM invalide: ${result?.code || "réponse inconnue"}.`,
    );
  }

  return result.durations.map((row, rowIndex) => {
    if (!Array.isArray(row) || row.length !== locations.length) {
      throw new Error(
        `Ligne invalide dans la matrice OSRM à l'index ${rowIndex}.`,
      );
    }

    return row.map((value, columnIndex) => {
      const duration = Number(value);
      if (!Number.isFinite(duration)) {
        throw new Error(
          `Durée OSRM indisponible pour la cellule ${rowIndex},${columnIndex}.`,
        );
      }

      return Math.round(duration);
    });
  });
};

// Convert eligible forms into tasks, add the depot, request the OSRM matrix, and build the optimizer payload.
const buildOptimPayloadFromForms = async (
  inputForms,
  {
    depotLocation,
    resourceId = sanitizeResourceId(equipe || "resource_default"),
  } = {},
) => {
  if (!Array.isArray(depotLocation) || depotLocation.length < 2) {
    throw new Error(
      "depotLocation est requis pour construire le payload d'optimisation.",
    );
  }

  const availabilities = [buildFullDayAvailability()];
  const skippedInterventions = [];

  const tasks = inputForms
    .map((form, index) => {
      const data = parseFormData(form?.data);
      const location = toLocation(data?.LatitudeLieu, data?.LongitudeLieu);

      if (!location) {
        skippedInterventions.push({
          index,
          formID: form?.metaData?.FORMID || form?.rowID || null,
          arrondissement: data?.Arrondissement ?? null,
          latitude: data?.LatitudeLieu ?? null,
          longitude: data?.LongitudeLieu ?? null,
          dataFields: Object.keys(data),
        });
        return null;
      }

      // Prefix each task ID with its arrondissement so it can be matched to a form later.
      // Use "global" when the form has no arrondissement value.
      const formArrondissement = data?.Arrondissement || "global";
      return {
        TaskID: `${formArrondissement}_${form?.metaData?.FORMID || form?.rowID}`,
        Priority: 0,
        location,
        Availabilities: availabilities,
        Duration: DEFAULT_TASK_DURATION_MIN,
        Quantities: [],
        AllowedResourceIDs: [resourceId],
        EndLocation: null,
        Lateness: null,
        SuggestedAppointment: null,
      };
    })
    .filter(Boolean);

  console.log(
    "[Optimisation] Interventions ignorées avant OSRM",
    skippedInterventions,
  );
  console.log("Optimisation OSRM input counts", {
    formCount: inputForms.length,
    taskCount: tasks.length,
    skippedWithoutCoordinates: inputForms.length - tasks.length,
  });
  if (tasks.length === 0) {
    throw new Error(
      "Aucune intervention avec des coordonnées valides (LatitudeLieu/LongitudeLieu) n'a été trouvée.",
    );
  }

  const locations = [...tasks.map((task) => task.location), depotLocation];
  console.log("[Optimisation] Coordonnées préparées pour OSRM", [
    ...tasks.map((task) => ({
      source: "intervention",
      taskID: task.TaskID,
      latitude: task.location[0],
      longitude: task.location[1],
      osrmCoordinate: `${task.location[1]},${task.location[0]}`,
    })),
    {
      source: "dépôt",
      latitude: depotLocation[0],
      longitude: depotLocation[1],
      osrmCoordinate: `${depotLocation[1]},${depotLocation[0]}`,
    },
  ]);
  const endLocationIndex = locations.length - 1;
  const osrmTimeMatrix = await buildOsrmTimeMatrix(locations);
  const timeMatrix = osrmTimeMatrix.map((row) =>
    row.map((duration, columnIndex) =>
      columnIndex === endLocationIndex ? 0 : duration,
    ),
  );

  const payload = {
    Resources: [
      {
        ResourceID: resourceId,
        StartLocation: endLocationIndex,
        EndLocation: endLocationIndex,
        Availability: buildFullDayAvailability(),
        Capacities: [],
        HourlyTravelCost: 10,
        ReturnLateness: null,
        HourlyRate: null,
        AssignmentCost: null,
      },
    ],
    Tasks: tasks.map(({ location, ...task }, index) => ({
      ...task,
      StartLocation: index,
    })),
    TravelMatrices: {
      TimeMatrix: timeMatrix,
    },
    Links: [],
  };

  return { payload, locations };
};

// Extract intervention IDs and stop positions from every optimized route schedule.
const buildTrajetResultsFromOptim = (optimResponse) => {
  const routes = optimResponse?.routes || {};

  // Process every route because the optimizer may return one route per arrondissement.
  const allResults = [];
  let globalPosition = 1;

  Object.values(routes).forEach((route) => {
    const schedule = route?.schedule || [];

    schedule.forEach((entry) => {
      const taskDescription = String(entry?.description || "");
      if (taskDescription.includes("_")) {
        // Remove the arrondissement prefix from "arrondissement_FORMID".
        const parts = taskDescription.split("_");
        const formID = parts.slice(1).join("_"); // Preserve underscores that belong to the FORMID.
        allResults.push({
          "Trajet_ArretCollec|1|FORMID": formID,
          Intervention_Position: String(globalPosition),
        });
        globalPosition++;
      }
    });
  });

  return allResults;
};

// Return a valid empty GeoJSON line when no usable route geometry is available.
const emptyTrajetGeoJson = () => ({
  type: "FeatureCollection",
  features: [
    {
      type: "Feature",
      properties: {},
      geometry: {
        type: "LineString",
        coordinates: [],
      },
    },
  ],
});

// Convert scheduled location indexes into OSRM route geometry, falling back to direct segments.
const buildTrajetGeoJsonFromOptim = async (optimResponse, locations) => {
  const routes = optimResponse?.routes || {};
  const firstRoute = Object.values(routes)?.[0] || {};
  const schedule = firstRoute?.schedule || [];

  if (!Array.isArray(schedule) || schedule.length < 2) {
    return emptyTrajetGeoJson();
  }

  if (!Array.isArray(locations) || locations.length === 0) {
    console.warn("Les localisations indexées sont absentes du résultat.");
    return emptyTrajetGeoJson();
  }

  const scheduleWithoutReturn = schedule.slice(0, -1);
  const routePoints = scheduleWithoutReturn
    .map((entry) => {
      const locationIndex = Number(entry?.location);
      if (
        !Number.isInteger(locationIndex) ||
        locationIndex < 0 ||
        locationIndex >= locations.length
      ) {
        console.warn(
          `Index de localisation invalide dans le planning: ${entry?.location}`,
        );
        return null;
      }

      const location = locations[locationIndex];
      const latitude = Number(location?.[0]);
      const longitude = Number(location?.[1]);
      if (
        !Number.isFinite(latitude) ||
        !Number.isFinite(longitude) ||
        latitude < -90 ||
        latitude > 90 ||
        longitude < -180 ||
        longitude > 180
      ) {
        console.warn(
          `Coordonnées invalides pour l'index de localisation ${locationIndex}.`,
        );
        return null;
      }

      return [latitude, longitude];
    })
    .filter(Boolean);

  if (routePoints.length < 2) {
    return emptyTrajetGeoJson();
  }

  const MAX_ROUTE_LOCATIONS = 200;
  const chunks = [];
  let start = 0;

  while (start < routePoints.length - 1) {
    const end = Math.min(start + MAX_ROUTE_LOCATIONS, routePoints.length);
    chunks.push(routePoints.slice(start, end));
    start = end - 1;
  }

  // Request detailed route geometry for one chunk to stay within OSRM URL limits.
  const getCoordinatesChunk = async (chunk) => {
    const coordinates = chunk
      .map(([latitude, longitude]) => `${longitude},${latitude}`)
      .join(";");
    const query = new URLSearchParams({
      approaches: chunk.map(() => "curb").join(";"),
      geometries: "geojson",
      overview: "full",
      steps: "false",
    });
    const endpoint = `${OSRM_BASE_URL.replace(/\/+$/, "")}/route/v1/${OSRM_PROFILE}/${coordinates}?${query}`;
    console.log("[OSRM Route] Request", {
      endpoint,
      locationCount: chunk.length,
      locations: chunk,
    });
    const response = await api({ local: true }).post(
      "external",
      {
        Method: "GET",
        Url: endpoint,
      },
      { validErrors: [400] },
    );
    console.log("[OSRM Route] Response", {
      status: response?.status,
      data: response?.data,
    });
    const result = response?.data;
    const routeCoordinates = result?.routes?.[0]?.geometry?.coordinates;
    if (
      result?.code !== "Ok" ||
      !Array.isArray(routeCoordinates) ||
      routeCoordinates.length === 0
    ) {
      throw new Error(
        `Géométrie OSRM invalide: ${result?.code || "réponse inconnue"}.`,
      );
    }

    return routeCoordinates.filter(
      (coordinate) =>
        Array.isArray(coordinate) &&
        coordinate.length >= 2 &&
        Number.isFinite(Number(coordinate[0])) &&
        Number.isFinite(Number(coordinate[1])),
    );
  };

  const allCoordinates = [];
  const routeGeometryErrors = [];
  for (const chunk of chunks) {
    try {
      const coordinates = await getCoordinatesChunk(chunk);
      coordinates.forEach((coordinate) => {
        const previous = allCoordinates[allCoordinates.length - 1];
        if (
          !previous ||
          previous[0] !== coordinate[0] ||
          previous[1] !== coordinate[1]
        ) {
          allCoordinates.push(coordinate);
        }
      });
    } catch (error) {
      console.warn("Échec du calcul de la géométrie OSRM.", error);
      routeGeometryErrors.push(getErrorMessage(error));
      chunk.forEach(([latitude, longitude]) => {
        const coordinate = [longitude, latitude];
        const previous = allCoordinates[allCoordinates.length - 1];
        if (
          !previous ||
          previous[0] !== coordinate[0] ||
          previous[1] !== coordinate[1]
        ) {
          allCoordinates.push(coordinate);
        }
      });
    }
  }

  if (routeGeometryErrors.length > 0) {
    showPopupError(
      "Avertissement de trajet",
      `OSRM n'a pas pu calculer ${routeGeometryErrors.length} segment(s). Un tracé direct entre les arrêts sera utilisé. Détail : ${routeGeometryErrors[0]}`,
    );
  }

  return {
    type: "FeatureCollection",
    features: [
      {
        type: "Feature",
        properties: {},
        geometry: {
          type: "LineString",
          coordinates: allCoordinates,
        },
      },
    ],
  };
};

// Submit the optimization payload to the webhook and parse its response body.
const apiOptim = async (body) => {
  try {
    // Wait for the webhook response and consume its complete body before returning.
    const response = await fetch(OPTIM_WEBHOOK_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(body),
    });

    const responseText = await response.text();
    let data;
    try {
      data = responseText ? JSON.parse(responseText) : null;
    } catch {
      data = responseText;
    }

    if (!response.ok) {
      throw new Error(`HTTP ${response.status}: ${getErrorMessage(data)}`);
    }

    return data;
  } catch (error) {
    console.error("Erreur lors de l’appel à l’API :", error);
    throw error;
  }
};

// Run validation, geocoding, OSRM routing, optimization, and document updates in order.
const main = async () => {
  let currentStage = "Initialisation";
  try {
    currentStage = "Validation des paramètres";
    // Stop before making external requests when no team is selected.
    if (!equipe || String(equipe).trim() === "") {
      showPopupError("Erreur", "Aucune équipe n'est sélectionnée.");
      return;
    }

    // Enforce the optimizer's maximum supported number of interventions.
    if (forms.length > MAX_OPTIMIZABLE_INTERVENTIONS) {
      showPopupError(
        "Erreur",
        `Le nombre d'interventions (${forms.length}) dépasse la limite de ${MAX_OPTIMIZABLE_INTERVENTIONS}. L'optimisation ne peut pas être effectuée.`,
      );
      return;
    }

    currentStage = "Géocodage de l'adresse de départ";
    const adresseDepart = edits?.AdresseDepart;
    const depotLocation = await geocodeAddress(adresseDepart);
    console.log("depotLocation (geocode)", depotLocation);

    console.log("arrondissement filter", arrondissement);

    // Ask before continuing when the user has not selected an arrondissement.
    currentStage = "Confirmation du filtre d'arrondissement";
    const hasFilterArrondissement = arrondissementFilterValues.length > 0;
    if (!hasFilterArrondissement) {
      const confirmed = await new Promise((resolve) => {
        showPopupConfirm(
          "Attention",
          "Aucun arrondissement n'a été sélectionné dans le filtre. L'optimisation va se faire sans filtre arrondissement. Voulez-vous continuer?",
          () => resolve(true),
          () => resolve(false),
        );
      });

      if (!confirmed) {
        return;
      }

      console.log("Optimisation sans filtre arrondissement confirmée");
    }

    showPopupLoading("Optimisation en cours");

    // Build one payload and one travel matrix for all eligible interventions.
    currentStage = "Construction de la matrice OSRM";
    const { payload: optimPayload, locations } =
      await buildOptimPayloadFromForms(forms, {
        depotLocation,
      });
    console.log("optimPayload", optimPayload);

    // Submit the combined payload once, rather than optimizing each arrondissement separately.
    currentStage = "Appel de l'API d'optimisation";
    const { success, data } = await apiOptim(optimPayload);
    console.log("data :", data);

    if (!success) {
      const optimizationError =
        typeof data === "string"
          ? data
          : data?.message || data?.error || data?.details;
      throw new Error(
        optimizationError
          ? `L'API d'optimisation a échoué : ${getErrorMessage(optimizationError)}`
          : "L'API d'optimisation a répondu success=false.",
      );
    }

    // Convert the optimizer schedule into form IDs and stop positions.
    currentStage = "Lecture des résultats d'optimisation";
    const allResults = buildTrajetResultsFromOptim(data);
    if (allResults.length === 0) {
      throw new Error(
        "L'API d'optimisation n'a retourné aucun arrêt dans son planning.",
      );
    }

    currentStage = "Calcul de la géométrie du trajet";
    const trajetGeoJson = await buildTrajetGeoJsonFromOptim(data, locations);
    console.log("allResults", allResults);
    console.log("trajetGeoJson", trajetGeoJson);

    // Find the team's existing route document, if one has already been created.
    const trajetFilters = [
      {
        key: "FORMLAYOUTNAME",
        operator: "EQUALS",
        value: "TRAJET",
        type: "TEXT",
      },
      {
        key: "EquipeAbribus",
        operator: "EQUALS",
        value: equipe,
        type: "TEXT",
      },
    ];
    currentStage = "Recherche du formulaire trajet de l'équipe";
    const trajetIDs = await getIds(trajetFilters);
    let trajetID = trajetIDs[0] || null;
    console.log("trajetIDs pour l'équipe", trajetIDs);

    if (trajetIDs.length > 1) {
      console.warn(
        "Plusieurs trajets existent déjà pour cette équipe; le premier sera mis à jour.",
      );
    }

    currentStage = "Lecture du formulaire trajet existant";
    const existingTrajetForms = trajetID ? await getForms([trajetID]) : [];
    const existingTrajetData = parseFormData(existingTrajetForms[0]?.data);
    // Preserve mappings outside the selected role/arrondissements while replacing this run's data.
    const mappingArrondissements =
      arrondissementFilterValues.length > 0
        ? arrondissementFilterValues
        : normalizeArrondissements(
            allResults.map((result) => {
              const interventionID = result["Trajet_ArretCollec|1|FORMID"];
              const form = forms.find((item) => {
                const formID = item?.metaData?.FORMID || item?.rowID;
                return (
                  formID != null && String(formID) === String(interventionID)
                );
              });
              return parseFormData(form?.data)?.Arrondissement;
            }),
          );
    const { mapping, geocode } = buildUpdatedMappingAndGeocode(
      existingTrajetData,
      mappingRole,
      mappingArrondissements,
      trajetGeoJson,
      adresseDepart,
      depotLocation[0],
      depotLocation[1],
    );

    const trajetDocument = {
      data: formatDataAPI({
        EquipeAbribus: equipe,
        Mapping: mapping,
        Geocode: geocode,
      }),
      status: "Actif",
      active: true,
      template: { templateId: trajetTemplateID },
    };

    currentStage = "Enregistrement du formulaire trajet";
    if (trajetID) {
      await updateManyDocument([
        {
          ...trajetDocument,
          documentID: trajetID,
        },
      ]);
    } else {
      await createManyDocument([trajetDocument]);
      currentStage = "Recherche du formulaire trajet créé";
      const createdTrajetIDs = await getIds(trajetFilters);
      trajetID = createdTrajetIDs[0] || null;
    }

    if (!trajetID) {
      throw new Error(
        "Impossible de retrouver le formulaire trajet de cette équipe.",
      );
    }

    currentStage = "Recherche des interventions liées au trajet";
    const arrondissementsToReplace =
      arrondissementFilterValues.length > 0
        ? arrondissementFilterValues
        : normalizeArrondissements(
            forms.map((form) => parseFormData(form?.data)?.Arrondissement),
          );
    const oldInterventionIDs = [
      ...new Set(
        (
          await Promise.all(
            arrondissementsToReplace.map((currentArrondissement) =>
              getIds([
                {
                  key: interventionTripFields.formId,
                  operator: "EQUALS",
                  value: trajetID,
                  type: "TEXT",
                },
                {
                  key: "Arrondissement",
                  operator: "EQUALS",
                  value: currentArrondissement,
                  type: "TEXT",
                },
              ]),
            ),
          )
        ).flat(),
      ),
    ];
    console.log("oldInterventionIDs", oldInterventionIDs);

    const allInterventionsToUpdate = [];
    const newInterventionIDs = [];

    allResults.forEach((result) => {
      const interventionID = result["Trajet_ArretCollec|1|FORMID"];
      const globalPosition = result["Intervention_Position"];
      const form = forms.find(
        (f) => (f?.metaData?.FORMID || f?.rowID) === interventionID,
      );
      if (!form) return;

      newInterventionIDs.push(interventionID);
      allInterventionsToUpdate.push({
        documentID: interventionID,
        data: formatDataAPI({
          [interventionTripFields.formId]: trajetID,
          [interventionTripFields.position]: globalPosition,
        }),
        status: "À faire",
        active: true,
        template: { templateId: interventionTemplateID },
      });
    });

    const removedInterventionIDs = oldInterventionIDs.filter(
      (id) => !newInterventionIDs.includes(id),
    );
    removedInterventionIDs.forEach((id) => {
      allInterventionsToUpdate.push({
        documentID: id,
        data: formatDataAPI({
          [interventionTripFields.formId]: "",
          [interventionTripFields.position]: "",
        }),
        status: "À faire",
        active: true,
        template: { templateId: interventionTemplateID },
      });
    });

    // Persist the new route link and position on each included intervention.
    if (allInterventionsToUpdate.length > 0) {
      currentStage = "Mise à jour des interventions";
      console.log("Mise à jour des interventions:", allInterventionsToUpdate);
      await updateManyDocument(allInterventionsToUpdate);
    }
  } catch (error) {
    const errorMessage = getErrorMessage(error);
    console.error(`[Optimisation] Échec à l'étape "${currentStage}" :`, error);
    showPopupError("Erreur d'optimisation", `${currentStage}\n${errorMessage}`);
  } finally {
    hidePopupLoading();
  }
};

main();

