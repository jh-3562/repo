// Flatten an array collection into indexed key/value fields for API documents.
const DataCollection = (key, array) => {
  let result = {};
  let itemCount = array?.length;
  array.forEach((obj, index) => {
    Object.keys(obj).forEach((fieldKey) => {
      const fieldIndex =
        collectionFieldIndexes[key]?.[fieldKey] ??
        Object.keys(obj).indexOf(fieldKey) + 1;
      let newKey = `${key}|${fieldIndex}|${fieldKey}|${index + 1}`;
      result[newKey] = obj[fieldKey];
    });
  });
  result[key] = String(itemCount ?? 0);
  return result;
};

// Copy an object while omitting fields managed separately by the API.
const excludeKeys = (obj, keys) =>
  Object.keys(obj).reduce((result, key) => {
    if (!keys.includes(key)) {
      result[key] = obj[key];
    }
    return result;
  }, {});

// Serialize arrays using the collection format and omit managed document fields.
const formatDataAPI = (data) => {
  Object.keys(data).forEach((key) => {
    if (Array.isArray(data[key])) {
      data = { ...data, ...DataCollection(key, data[key]) };
    }
  });
  return JSON.stringify(excludeKeys(data, ["FORMID", "NUMBER"]));
};

// Restore a collection from either native arrays or flattened API fields.
const parseDataCollection = (data, collectionKey) => {
  if (Array.isArray(data?.[collectionKey])) {
    return data[collectionKey].map((row) => ({ ...row }));
  }

  const rowCount = Number.parseInt(data?.[collectionKey], 10);
  if (!Number.isInteger(rowCount) || rowCount <= 0) {
    return [];
  }

  return Array.from({ length: rowCount }, (_, index) => {
    const rowNumber = index + 1;
    const prefix = `${collectionKey}|`;
    return Object.entries(data || {}).reduce((row, [key, value]) => {
      if (!key.startsWith(prefix)) {
        return row;
      }

      const parts = key.slice(prefix.length).split("|");
      if (parts.length === 3 && Number(parts[2]) === rowNumber) {
        row[parts[1]] = value;
      } else if (parts.length === 2 && Number(parts[0]) === rowNumber) {
        row[parts[1]] = value;
      }
      return row;
    }, {});
  }).filter((row) => Object.keys(row).length > 0);
};

// Generate a geocode key that does not collide with existing records.
const createUniqueGeocodeKey = (existingGeocodes) => {
  const existingKeys = new Set(
    existingGeocodes.map((row) => String(row?.GeocodeKey ?? "")),
  );
  const cryptoApi =
    typeof globalThis !== "undefined" ? globalThis.crypto : undefined;
  let geocodeKey;

  do {
    geocodeKey =
      cryptoApi?.randomUUID?.() ||
      `geocode_${Date.now()}_${Math.random().toString(36).slice(2)}`;
  } while (existingKeys.has(geocodeKey));

  return geocodeKey;
};

