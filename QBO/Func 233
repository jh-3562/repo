/*VALIDATION: CHAMPS OBLIGATOIRES */
const requireFields = (doc) => {
  const REQUIRED = ['TypeIntervention', 'SousCatégorie1', 'DélaiSLA', 'NumAbribus'];
  const missing = [];
  for (const k of REQUIRED) {
    const v = doc?.[k];
    const s = v == null ? '' : String(v).trim();
    if (!s) missing.push(k);
  }
  if (missing.length) {
    __displayError(`Veuillez compléter les champs obligatoires:\n- ${missing.join('\n- ')}`);
    throw new Error(`Champs obligatoires manquants: ${missing.join(', ')}`);
  }
};

/*  FORMATAGE DONNÉES POUR L'API  */
const DataCollection = (key, array) => {
  const result = {};
  const itemCount = array?.length || 0;
  array?.forEach((obj, index) => {
    Object.keys(obj || {}).forEach((k) => {
      result[`${k}|${index + 1}`] = obj[k];
    });
  });
  result[key] = String(itemCount);
  return result;
};

const excludeKeys = (obj, keys) =>
  Object.keys(obj || {}).reduce((res, k) => {
    if (!keys.includes(k)) res[k] = obj[k];
    return res;
  }, {});

const formatDataAPI = (data) => {
  let formattedData = { ...data };
  Object.keys(formattedData || {}).forEach((k) => {
    if (Array.isArray(formattedData[k])) {
      formattedData = { ...formattedData, ...DataCollection(k, formattedData[k]) };
    }
  });
  return JSON.stringify(excludeKeys(formattedData, ['FORMID', 'NUMBER']));
};

/* STATUS / NOTIFS */
const normalizeStatus = (s) =>
  String(s || '').normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();

const shouldNotifyStatusChange = (previousStatus) => {
  const previousStatusNorm = normalizeStatus(previousStatus);
  const targetStatusNorm = normalizeStatus(TARGET_STATUS);
  return previousStatusNorm !== targetStatusNorm;
};

const shouldNotifySauveVitreTeam = (previousTeam, newTeam) =>
  previousTeam !== newTeam && newTeam === EQUIPE_SAUVE_VITRES;

/*  PAYLOAD */
const buildDataPayload = (docData) => {
  return docData;
};

const fetchCurrentDocumentData = async (api, formId) => {
  try {
    const res = await api({ local: true }).post('document/id', { ids: [formId] });
    const doc = res?.data?.documents?.[0] || {};
    return doc;
  } catch (e) {
    console.warn('[DB] database read failed', e);
    return { status: null, data: {}, metaData: {} };
  }
};

const extractFormId = (response) => {
  const directId = response?.data?.id;
  if (directId) return directId;
  const location = response?.headers?.location;
  if (typeof location === 'string') {
    const parts = location.split('/');
    return parts[parts.length - 1] || null;
  }
  return null;
};

const createDocument = async (api, data, templateId) => {
  const payload = {
    data: formatDataAPI(data),
    status: TARGET_STATUS,
    active: true,
    template: { templateId },
  };
  const res = await api({ local: true }).post('document', { document: payload });
  console.log('[CREATE][RAW]', res);
  return extractFormId(res);
};

const updateDocument = async (api, data, templateId, formId) => {
  const payload = {
    data: formatDataAPI(data),
    status: TARGET_STATUS,
    active: true,
    template: { templateId },
    documentID: formId,
  };
  const res = await api({ local: true }).put('document', { document: payload });
  console.log('[UPDATE][RAW]', res);
  return formId;
};

