/* FLOW */
const creerOuMettreAJourEtNotifier = async (api, docData, templateId) => {
  requireFields(docData);

  const isNew = Number(docData?.NUMBER) === 0;

  let formId;
  let shouldCallWebhook = false;
  let shouldCallSauveVitresWebhook = false;
  let data = buildDataPayload(docData);

  if (isNew) {
    formId = await createDocument(api, data, templateId);
    shouldCallWebhook = true;

    if (data.EquipeAbribus === EQUIPE_SAUVE_VITRES) {
      shouldCallSauveVitresWebhook = true;
    }
  } else {
    const formIdCandidate = String(docData?.FORMID || '').trim();
    if (!formIdCandidate) throw new Error('FORMID manquant pour la mise à jour');

    const current = await fetchCurrentDocumentData(api, formIdCandidate);

    const previousStatus =
      current?.metaData?.STATUS ?? current?.status ?? current?.STATUS ?? null;
    const previousTeam = current?.data?.EquipeAbribus;

    const duplicateNotifValue = String(data?.DuppliquerNotif || '').trim().toLowerCase();
    const shouldForceWebhookByDuplicateNotif = duplicateNotifValue === 'true';

    if (shouldForceWebhookByDuplicateNotif) {
      shouldCallWebhook = true;
      shouldCallSauveVitresWebhook = data.EquipeAbribus === EQUIPE_SAUVE_VITRES;
      data = {
        ...data,
        DuppliquerNotif: 'false',
      };
    } else {
      shouldCallWebhook = shouldNotifyStatusChange(previousStatus);
      shouldCallSauveVitresWebhook = shouldNotifySauveVitreTeam(previousTeam, data.EquipeAbribus);
    }

    formId = await updateDocument(api, data, templateId, formIdCandidate);
  }

  

  if (!formId) throw new Error("Impossible de déterminer l'ID du formulaire");

  const webhookResult = await callMainWebhook(shouldCallWebhook, formId);
  const sauveVitresResult = await callSauveVitresWebhook(shouldCallSauveVitresWebhook, formId);

  return {
    formId,
    webhook: webhookResult,
    webhookSauveVitres: sauveVitresResult,
    mode: isNew ? 'create' : 'update',
    webhookCalled: !!shouldCallWebhook,
    webhookSauveVitresCalled: !!shouldCallSauveVitresWebhook,
  };
};

