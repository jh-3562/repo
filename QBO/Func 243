const hidePopupLoading = () => {
  const el = document.getElementById("loadingPopup");
  if (el) el.remove();
};

// -------------------- DATE HELPERS --------------------
const pad = (n) => String(n).padStart(2,'0');
const todayYYYYMMDD = () => {
  const d = new Date();
  return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
};

