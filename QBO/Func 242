async function mettreAJourEnTraiteEtNotifier(api, docData, templateId) {
  const pad = (n) => String(n).padStart(2, "0");

  const nowLocalISO = () => {
    const d = new Date();
    return (
      d.getFullYear() +
      "-" +
      pad(d.getMonth() + 1) +
      "-" +
      pad(d.getDate()) +
      "T" +
      pad(d.getHours()) +
      ":" +
      pad(d.getMinutes()) +
      ":" +
      pad(d.getSeconds())
    );
  };

  const DataCollection = (key, array) => {
    let result = {};
    const itemCount = array?.length || 0;

    array?.forEach((obj, index) => {
      Object.keys(obj || {}).forEach((k) => {
        result[`${k}|${index + 1}`] = obj[k];
      });
    });

    result[key] = String(itemCount);
    return result;
  };

  const excludeKeys = (obj, keys) =>
    Object.keys(obj || {}).reduce((res, k) => {
      if (!keys.includes(k)) res[k] = obj[k];
      return res;
    }, {});

  const formatDataAPI = (data) => {
    let formattedData = { ...(data || {}) };

    Object.keys(formattedData).forEach((k) => {
      if (Array.isArray(formattedData[k])) {
        formattedData = {
          ...formattedData,
          ...DataCollection(k, formattedData[k]),
        };
      }
    });

    return JSON.stringify(excludeKeys(formattedData, ["FORMID", "NUMBER"]));
  };

  const getDateCompletionAndYear = (dateHeureComplete) => {
    const v = String(dateHeureComplete || "").trim();

    if (!v) {
      return {
        DateCompletion: "",
        AnneeCompletion: "",
      };
    }

    const datePart = v.split("T")[0].split(" ")[0];
    const m = datePart.match(/^(\d{4})-(\d{2})-(\d{2})$/);

    if (!m) {
      return {
        DateCompletion: "",
        AnneeCompletion: "",
      };
    }

    return {
      DateCompletion: `${m[1]}-${m[2]}-${m[3]}`,
      AnneeCompletion: m[1],
    };
  };

  const mainSequencing2 = async (API, docData) => {
    const sequencingPad2 = (value) => String(value).padStart(2, "0");

    const sequencingNowLocalISO = () => {
      const date = new Date();

      return `${date.getFullYear()}-${sequencingPad2(
        date.getMonth() + 1,
      )}-${sequencingPad2(date.getDate())}T${sequencingPad2(
        date.getHours(),
      )}:${sequencingPad2(date.getMinutes())}:${sequencingPad2(
        date.getSeconds(),
      )}`;
    };

    const sequencingIsFutureDate = (dateString) => {
      if (!dateString) return "";

      const parts = String(dateString).split("-").map(Number);

      if (parts.length !== 3 || parts.some(Number.isNaN)) {
        return "";
      }

      const [year, month, day] = parts;
      const inputDate = new Date(year, month - 1, day);

      if (Number.isNaN(inputDate.getTime())) {
        return "";
      }

      const now = new Date();
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      if (now.getHours() >= 22) {
        today.setDate(today.getDate() + 1);
      }

      return inputDate <= today ? "Non" : "Oui";
    };

    const getNumAbribusFilterValue = (data) => {
      const rawValue = data?.NumAbribus;

      const values = Array.isArray(rawValue)
        ? rawValue
        : String(rawValue || "").split("|");

      const uniqueValues = [
        ...new Set(values.map((value) => String(value).trim()).filter(Boolean)),
      ];

      if (!uniqueValues.length) {
        throw new Error("NumAbribus manquant pour le sequencage");
      }

      return uniqueValues.join("|");
    };

    const getLocalISOInDays = (days) => {
      const date = new Date();
      date.setDate(date.getDate() + days);

      return `${date.getFullYear()}-${sequencingPad2(
        date.getMonth() + 1,
      )}-${sequencingPad2(date.getDate())}T${sequencingPad2(
        date.getHours(),
      )}:${sequencingPad2(date.getMinutes())}:${sequencingPad2(
        date.getSeconds(),
      )}`;
    };

    const getDocumentIdsByFilters = async (
      filters,
      errorMessage,
      requestOptions = {},
    ) => {
      const response = await API({ local: true }).post("document/id/filter", {
        filters,
        ...requestOptions,
      });

      if (response?.status !== 200) {
        throw new Error(errorMessage);
      }

      return Array.isArray(response?.data?.ids) ? response.data.ids : [];
    };

    const getDocumentsByIds = async (ids) => {
      if (!ids.length) return [];

      const response = await API({ local: true }).post("document/id", { ids });

      if (response?.status !== 200) {
        throw new Error("Probleme pendant la recuperation des donnees abribus");
      }

      return Array.isArray(response?.data?.documents)
        ? response.data.documents
        : [];
    };

    const INTERVENTION_TEMPLATE_ID = "f7b9a59a-e708-45c4-b786-2a5130cfee2b";

    const STATUS_KEY = "À faire";
    const TYPE_INTERVENTION = "Entretien";

    const norm = (value) => String(value ?? "").trim();

    const toDate = (value) => {
      if (!value) return null;

      const date = new Date(value);

      return Number.isNaN(date.getTime()) ? null : date;
    };

    const toLocalYMD = (value) => {
      const stringValue = norm(value);
      const match = stringValue.match(/^(\d{4})-(\d{2})-(\d{2})$/);

      if (!match) return null;

      const date = new Date(
        Number(match[1]),
        Number(match[2]) - 1,
        Number(match[3]),
      );

      return Number.isNaN(date.getTime()) ? null : date;
    };

    const addDays = (date, days) =>
      new Date(
        date.getFullYear(),
        date.getMonth(),
        date.getDate() + days,
        date.getHours(),
        date.getMinutes(),
        date.getSeconds(),
      );

    const addHours = (date, hours) =>
      new Date(date.getTime() + hours * 60 * 60 * 1000);

    const addMonths = (date, months) =>
      new Date(
        date.getFullYear(),
        date.getMonth() + months,
        date.getDate(),
        date.getHours(),
        date.getMinutes(),
        date.getSeconds(),
      );

    const midnight = (date) =>
      new Date(date.getFullYear(), date.getMonth(), date.getDate());

    const isoDate = (date) =>
      `${date.getFullYear()}-${sequencingPad2(
        date.getMonth() + 1,
      )}-${sequencingPad2(date.getDate())}`;

    const isoDateTime = (date) =>
      `${isoDate(date)}T${sequencingPad2(
        date.getHours(),
      )}:${sequencingPad2(date.getMinutes())}:${sequencingPad2(
        date.getSeconds(),
      )}`;

    const applySLAFromLast = (date, slaLabel) => {
      const normalizedSla = norm(slaLabel).toLowerCase();

      if (normalizedSla === "4h") return addHours(date, 4);
      if (normalizedSla === "12h") return addHours(date, 12);
      if (normalizedSla === "24h") return addDays(date, 1);
      if (normalizedSla === "48h") return addDays(date, 2);
      if (normalizedSla === "72h") return addDays(date, 3);
      if (normalizedSla === "4 jours") return addDays(date, 4);
      if (normalizedSla === "7 jours") return addDays(date, 7);
      if (normalizedSla === "1 mois") return addMonths(date, 1);
      if (normalizedSla === "3 mois") return addMonths(date, 3);

      return addDays(date, 1);
    };

    const parseApiDoc = (doc) => {
      const rawData = doc?.data ?? doc;
      let dataObj = {};

      if (typeof rawData === "string") {
        try {
          dataObj = JSON.parse(rawData || "{}");
        } catch {
          dataObj = {};
        }
      } else if (rawData && typeof rawData === "object") {
        dataObj = rawData;
      }

      const metadata = doc?.metaData || {};

      const formLayoutId =
        metadata.FORMLAYOUTID ||
        doc?.template?.templateId ||
        INTERVENTION_TEMPLATE_ID;

      return {
        dataObj,
        formLayoutId,
      };
    };

    const excludeKeys = new Set([
      "Photo_NumSerieFABCO",
      "IDplainte",
      "Photo_4BoulonsSecuriteToit",
      "Photo_AbribusApresIntervention",
      "Photo_AbribusAvantIntervention",
      "Photo_AbribusCompletCoteReparation",
      "Photo_AbribusCompletDeneige",
      "Photo_AbribusCompletDeneigeCoteOppose",
      "Photo_AbribusCompletLave",
      "Photo_AbribusCompletLaveCoteOppose",
      "Photo_BraquetteInstallee",
      "Intervention_commentaires",
      "Photo_DalleCoulee",
      "CommandDate",
      "DateDue",
      "DateHeureComplete",
      "DateCompletion",
      "AnneeCompletion",
      "DélaiSLA",
      "DocumentsSupp",
      "EquipeAbribus",
      "Photo_GrosPlanFaceExt",
      "Photo_GrosPlanFaceInt",
      "Photo_Intervention",
      "Intervention_Notes_Solution",
      "Intervention_Notes_Probleme",
      "Photo_NumSerie",
      "Photo_NumeroDeSerie",
      "Photo_PanneauArret",
      "Photos",
      "Photo_PlanEloigneAbribusCompletFaceExt",
      "Photo_PlanEloigneAbribusCompletFaceInt",
      "Photo_PlanRaproccheReparation",
      "PositionTournee",
      "Photo_ProblemeAReparer",
      "RaisonNonComplétion",
      "Photo_SiteApresSecurisation",
      "Photo_SiteEnArrivant",
      "Photo_SiteSansAbribus",
      "SousCatégorie1",
      "SPVM",
      "Photo_VerreApresPolissage",
      "Photo_VerreAvant",
      "Photo_VerreBrise",
      "Abribus_Deneigement",
      "Abribus_Deneigement_Notes",
      "Poubelle",
      "Positionnement",
      "Notifications_Assignation",
      "Notifications_Completion",
      "Notifications_AssignationManuel",
      "Notifications_CompletionManuel",
      "Photo_obligatoire3",
    ]);

    const excludePrefixes = [
      "DocumentsSupp|",
      "Photos|",
      "Notifications_Assignation|",
      "Notifications_Completion|",
      "Notifications_AssignationManuel|",
      "Notifications_CompletionManuel|",
    ];

    const scrubClone = (source) => {
      const output = {};

      for (const [key, value] of Object.entries(source || {})) {
        if (excludeKeys.has(key)) continue;

        if (excludePrefixes.some((prefix) => key.startsWith(prefix))) {
          continue;
        }

        output[key] = value;
      }

      return output;
    };

    const numAbribus = getNumAbribusFilterValue(docData);
    const currentFormId = norm(docData?.FORMID).toLowerCase();

    const dateNow = sequencingNowLocalISO();
    const dateIn60Days = getLocalISOInDays(60);

    // 1. Récupération des abribus actifs.

    const abribusIds = await getDocumentIdsByFilters(
      [
        {
          key: "FORMLAYOUTNAME",
          operator: "EQUALS",
          value: "ABRIBUS",
          type: "TEXT",
        },
        {
          key: "STATUS",
          operator: "EQUALS",
          value: "Actif",
          type: "TEXT",
        },
        {
          key: "NumAbribus",
          operator: "IN",
          value: numAbribus,
          type: "TEXT",
        },
      ],
      "Probleme pendant la recherche des formulaires abribus",
    );

    const abribusDocuments = await getDocumentsByIds(abribusIds);

    // 2. Récupération des interventions futures.

    const matchingFutureInterventionIds = await getDocumentIdsByFilters(
      [
        {
          key: "FORMLAYOUTNAME",
          operator: "EQUALS",
          value: "INTERVENTION",
          type: "TEXT",
        },
        {
          key: "STATUS",
          operator: "IN",
          value: "Problématique|À faire|Non-Assignée|Non-assignée",
          type: "TEXT",
        },
        {
          key: "TypeIntervention",
          operator: "EQUALS",
          value: TYPE_INTERVENTION,
          type: "TEXT",
        },
        {
          key: "DateDue",
          operator: "BETWEEN",
          value: `${dateNow}|${dateIn60Days}`,
          type: "DATETIME",
        },
        {
          key: "NumAbribus",
          operator: "IN",
          value: numAbribus,
          type: "TEXT",
        },
      ],
      "Probleme pendant la recherche des interventions futures",
      {
        sort: [
          {
            key: "DateDue",
            direction: "ASC",
          },
        ],
        limit: 1000,
      },
    );

    const futureInterventionIds = matchingFutureInterventionIds.filter(
      (id) => !currentFormId || norm(id).toLowerCase() !== currentFormId,
    );

    const futureInterventionDocuments = await getDocumentsByIds(
      futureInterventionIds,
    );

    // 3. Recherche de la dernière intervention complétée.

    const interCompleted = [docData];
    const abriDocs = abribusDocuments;
    const futureDocs = futureInterventionDocuments;

    const lastByNumCat = {};

    for (const interventionDocument of interCompleted) {
      const { dataObj, formLayoutId } = parseApiDoc(interventionDocument);

      if (norm(dataObj.TypeIntervention) !== TYPE_INTERVENTION) {
        continue;
      }

      const number = norm(dataObj.NumAbribus);
      if (!number) continue;

      const subCategory = norm(dataObj.SousCatégorie1);

      const category =
        subCategory === "Régulier - Supplémentaire" ? "suppl" : "reg";

      const completedAt = toDate(dataObj.DateHeureComplete);
      if (!completedAt) continue;

      const key = `${number}||${category}`;
      const current = lastByNumCat[key];

      if (!current || completedAt > current.DateHeureComplete) {
        lastByNumCat[key] = {
          dataObj,
          formLayoutId,
          NumAbribus: number,
          SousCatégorie1: subCategory,
          DateHeureComplete: completedAt,
          SLA_Last: dataObj.DélaiSLA || "24h",
          Position_Last: dataObj.PositionTournee || "",
        };
      }
    }

    // 4. Extraction des séquences configurées sur chaque abribus.

    const sequencesByNum = {};

    for (const abribusDocument of abriDocs) {
      const { dataObj } = parseApiDoc(abribusDocument);
      const number = norm(dataObj.NumAbribus);

      if (!number) continue;

      const rows = {};

      for (const [key, value] of Object.entries(dataObj)) {
        if (!key.startsWith("Seq|")) continue;

        const parts = key.split("|");
        if (parts.length !== 4) continue;

        const rowNumber = parts[3];
        const field = parts[2];

        rows[rowNumber] = rows[rowNumber] || {
          rowNumber,
        };

        rows[rowNumber][field] = value;
      }

      const sequences = Object.values(rows)
        .map((row) => ({
          rowNumber: row.rowNumber,
          Equipe: norm(row.Equipe),
          Position: norm(row.Position),
          Frequence: Number(norm(row.Frequence || "0")),
          Periode: norm(row.Periode),
          Type: norm(row.Type),
          SousCategorie: norm(row.SousCategorie),
          Delai: norm(row.Delai),
        }))
        .filter(
          (sequence) =>
            Number.isFinite(sequence.Frequence) && sequence.Frequence > 0,
        );

      if (sequences.length) {
        sequencesByNum[number] = sequences;
      }
    }

    // 5. Recherche de la prochaine échéance existante par catégorie.

    const futureMinDueByNumCat = {};

    for (const futureDocument of futureDocs) {
      const { dataObj } = parseApiDoc(futureDocument);

      if (norm(dataObj.TypeIntervention) !== TYPE_INTERVENTION) {
        continue;
      }

      const number = norm(dataObj.NumAbribus);
      if (!number) continue;

      const subCategory = norm(dataObj.SousCatégorie1);

      const category =
        subCategory === "Régulier - Supplémentaire" ? "suppl" : "reg";

      const dueDate = toDate(dataObj.DateDue);
      if (!dueDate) continue;

      const key = `${number}||${category}`;

      if (!futureMinDueByNumCat[key] || dueDate < futureMinDueByNumCat[key]) {
        futureMinDueByNumCat[key] = dueDate;
      }
    }

    // 6. Sélection de la prochaine intervention à créer.

    let chosen = null;
    let hasExistingFuture = false;
    let hasMatchingSequence = false;

    const today = new Date();

    for (const [key, source] of Object.entries(lastByNumCat)) {
      const [number, category] = key.split("||");

      const sequences = (sequencesByNum[number] || []).filter((sequence) => {
        const isSupplementary =
          sequence.SousCategorie === "Régulier - Supplémentaire";

        const matchesCategory =
          category === "suppl" ? isSupplementary : !isSupplementary;

        const matchesType =
          !sequence.Type ||
          sequence.Type === norm(source.dataObj.TypeIntervention);

        return matchesCategory && matchesType;
      });

      if (!sequences.length) continue;

      // Même logique que dans le code de complétion.
      hasMatchingSequence = true;

      const minimumFutureDue = futureMinDueByNumCat[key];

      if (minimumFutureDue && source.DateHeureComplete < minimumFutureDue) {
        hasExistingFuture = true;
        continue;
      }

      for (const sequence of sequences) {
        const newDate = addDays(source.DateHeureComplete, sequence.Frequence);

        const [startValue, endValue] = (sequence.Periode || "").split("|");

        const startDate = toLocalYMD(startValue) || toDate(startValue);

        const endDate = toLocalYMD(endValue) || toDate(endValue);

        if (endDate) {
          endDate.setHours(23, 59, 59, 999);
        }

        if (startDate && newDate < startDate) continue;
        if (endDate && newDate > endDate) continue;

        const dueDate = applySLAFromLast(newDate, source.SLA_Last);

        if (midnight(dueDate) < midnight(today)) {
          continue;
        }

        if (!chosen || dueDate < chosen.DateDue) {
          chosen = {
            source,
            sequence,
            NewDate: newDate,
            DateDue: dueDate,
          };
        }
      }
    }

    // 7. Préparation du document séquencé.

    let sequencingDocument = null;

    if (chosen) {
      const base = scrubClone(chosen.source.dataObj);

      base.CommandDate = isoDate(chosen.NewDate);
      base.DateDue = isoDateTime(chosen.DateDue);

      base["DélaiSLA"] = chosen.sequence.Delai || "24h";

      base.EquipeAbribus = chosen.sequence.Equipe || "";

      base["SousCatégorie1"] =
        chosen.sequence.SousCategorie || chosen.source.SousCatégorie1 || "";

      base.PositionTournee =
        chosen.sequence.Position || chosen.source.Position_Last || "";

      base.TypeIntervention = TYPE_INTERVENTION;
      base.NumAbribus = chosen.source.NumAbribus;

      base.FrequenceSequence = String(chosen.sequence.Frequence || "");

      base.Sequence = String(chosen.sequence.rowNumber || "");

      base.InterventionDateCreationValide = sequencingIsFutureDate(
        base.CommandDate,
      );

      sequencingDocument = {
        data: JSON.stringify(base),
        status: STATUS_KEY,
        active: true,
        template: {
          templateId: chosen.source.formLayoutId || INTERVENTION_TEMPLATE_ID,
        },
      };
    }

    // 8. Création de l'intervention séquencée.

    let createdDocument = null;

    if (sequencingDocument) {
      const response = await API({ local: true }).post("document", {
        document: sequencingDocument,
      });

      if (!response || response.status < 200 || response.status >= 300) {
        throw new Error(
          "Probleme pendant la creation de l'intervention sequencee",
        );
      }

      createdDocument = response.data || null;
    }

    return {
      abribusIds,
      abribusDocuments,
      futureInterventionIds,
      futureInterventionDocuments,
      document: sequencingDocument,
      createdDocument,
      hasExistingFuture,
      hasMatchingSequence,
    };
  };

  // 9. Vérification du document à passer au statut « Traité ».

  const number = Number(docData?.NUMBER);
  const formId = String(docData?.FORMID || "").trim();

  if (number === 0) {
    throw new Error(
      "Impossible de passer en 'Traité' sur un document non créé (NUMBER = 0)",
    );
  }

  if (!formId) {
    throw new Error("FORMID manquant pour la mise à jour en 'Traité'");
  }

  const dateHeureComplete =
    docData?.DateHeureComplete &&
    String(docData.DateHeureComplete).trim() !== ""
      ? docData.DateHeureComplete
      : nowLocalISO();

  const stampedData = {
    ...docData,
    DateHeureComplete: dateHeureComplete,
    ...getDateCompletionAndYear(dateHeureComplete),
  };

  console.log("[TRAITE][START] NUMBER:", number, "FORMID:", formId);

  let sequencing = null;
  let sequencingError = null;

  try {
    sequencing = await mainSequencing2(api, stampedData);
  } catch (e) {
    sequencingError = e?.message || String(e);
  }

  // 10. Même condition hasMatchingSequence que dans le code précédent.
  //
  // Une erreur est déclenchée uniquement si :
  // - une séquence correspond à l'intervention ;
  // - aucune intervention séquencée n'a été créée ;
  // - aucune intervention future existante ne justifie l'absence de création.

  if (
    !sequencingError &&
    sequencing?.hasMatchingSequence &&
    !sequencing?.createdDocument &&
    !sequencing?.hasExistingFuture
  ) {
    sequencingError =
      "Aucune nouvelle intervention n'a ete creee par le sequencage.";
  }

  if (sequencingError) {
    return {
      formId,
      sequencing,
      hasErrors: true,
      sequencingError,
    };
  }

  // 11. Mise à jour du document au statut « Traité ».

  const payloadUpdate = {
    data: formatDataAPI(stampedData),
    status: "Traité",
    active: true,
    template: {
      templateId,
    },
    documentID: formId,
  };

  console.log("[TRAITE][PUT][PAYLOAD]", payloadUpdate);

  const res = await api({ local: true }).put("document", {
    document: payloadUpdate,
  });

  console.log("[TRAITE][PUT][RAW]", res);

  return {
    formId,
    sequencing,
    hasErrors: false,
    sequencingError: null,
  };
}

const redirectToViewGroup = () => {
  const lastCustomPage = localStorage.getItem("lastCustomPage");

  if (lastCustomPage && lastCustomPage.startsWith("/")) {
    window.location.replace(lastCustomPage);
    return;
  }

  const pathname = window.location.pathname;
  const segments = pathname.split("/").filter(Boolean);

  const basePath = segments.length > 0 ? `/${segments[0]}` : "/";

  window.location.replace(basePath);
};

(async function mainTraite() {
  try {
    const templateId = "f7b9a59a-e708-45c4-b786-2a5130cfee2b";

    console.log(
      "[MAIN-TRAITE] start – NUMBER:",
      docData?.NUMBER,
      "FORMID:",
      docData?.FORMID,
    );

    // Mise à jour de InterventionDateCreationValide.

    const updateDocData = {
      ...docData,
      InterventionDateCreationValide:
        docData?.CommandDate && typeof isFutureDate === "function"
          ? isFutureDate(docData.CommandDate)
          : "Non",
    };

    docData = updateDocData;

    const out = await mettreAJourEnTraiteEtNotifier(api, docData, templateId);

    console.log("[MAIN-TRAITE] done:", out);

    if (!out) return;

    if (out.hasErrors) {
      if (typeof showErrorBanner === "function") {
        showErrorBanner(out.sequencingError);
      }

      return;
    }

    redirectToViewGroup();
  } catch (e) {
    console.error("[MAIN-TRAITE][ERREUR]", e);

    if (typeof showErrorBanner === "function") {
      showErrorBanner(e?.message || String(e));
    }
  }
})();

