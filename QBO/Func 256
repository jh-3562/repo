    rules.Photo_INTTubeFluo = !isNum && isPubRtl;
    rules.Photo_EXTPorteOuverteEntiere = !isNum;
    rules.Photo_EXTAfficheReplacee = !isNum;
    rules.Photo_EXTBarreNoirBas = !isNum && !isPubRtl;
    rules.Photo_EXTTubeFluo = !isNum && isPubRtl;
    rules.Photo_VisGraissees = !isNum && isPubRtl;
  }

  rules.Photo_EmplacementAvantNumero = cat === "Numéro";
  rules.Photo_NumeroPose = cat === "Numéro";

  const isTachesDesinstallation = cat === "Tâches désinstallation";
  rules.Desinstallation_Tache1 = isTachesDesinstallation;
  rules.Desinstallation_Tache2 = isTachesDesinstallation;
  rules.Desinstallation_Tache3 = isTachesDesinstallation;
  rules.installationPlanned = cat === "Avis d’entrave";
  rules.takedownValidation = cat === "Avis d’entrave";

  const isTachesInstallation = cat === "Tâches installation";
  rules.Installation_Tache1 = isTachesInstallation;
  rules.Installation_Tache2 = isTachesInstallation;
  rules.Installation_Tache3 = isTachesInstallation;

  return Object.keys(rules).filter((key) => rules[key]);
};

