const getFieldLabel = (key) => {
  const label = FIELD_LABELS[key] || key;
  return key.startsWith("Photo_") ? `Photo « ${label} »` : label;
};

const isMissing = (value) => {
  if (value == null) return true;
  const text = String(value).trim();
  return text === "" || text === "[]" || text === "false";
};

const getMissingFields = (data, requiredKeys) =>
  requiredKeys.filter((key) => isMissing(data[key]));

// Les champs exigés à la création sont déjà remplis : seuls les photos et tâches de complétion restent.
const getRequiredFields = (targetStatus, intervention) => {
  if (targetStatus !== STATUTS.COMPLETE) return [];
  return getConditionalRequiredFields(intervention.data);
};

// -------------------- LECTURE --------------------
// Bouton : étape de sélection puis popup. Clic droit : popup en premier, sur la ligne cliquée.
const getSelection = () => {
  const rawProcessData = store?.pageContentStore?.processData || {};
  const processData = Object.keys(rawProcessData)
    .sort((a, b) => Number(a) - Number(b))
    .map((key) => rawProcessData[key]);
  const popupIndex = processData.findIndex(
    (step) => step?.edits && STATUS_FIELD_KEY in step.edits,
  );
  const edits = processData[popupIndex]?.edits || {};
  if (popupIndex > 0) {
    return { ids: processData[popupIndex - 1]?.result?.ids || [], edits };
  }
  const clickedId = store?.pageContentStore?.active?.[0];
  return { ids: clickedId ? [clickedId] : [], edits };
};

const parseDocument = (doc) => {
  let data = {};
  try {
    data =
      typeof doc.data === "string"
        ? JSON.parse(doc.data || "{}")
        : doc.data || {};
  } catch {
    data = {};
  }
  const formId = doc.metaData?.FORMID;
  return {
    formId,
    number: doc.metaData?.NUMBER ?? data.NUMBER ?? formId,
    status: doc.metaData?.STATUS,
    data: { ...data, FORMID: formId },
  };
};

const getInterventions = async (ids) => {
  const response = await api({ local: true }).post("document/id", { ids });
  const documents = response?.data?.documents;
  if (!Array.isArray(documents))
    throw new Error("Impossible de lire les interventions sélectionnées.");
  return documents.map(parseDocument);
};

// -------------------- VALIDATION --------------------
const getBlockingReason = (intervention, targetStatus) => {
  if (
    intervention.status === STATUTS.COMPLETE &&
    targetStatus !== STATUTS.A_REFAIRE
  ) {
    return {
      text: `déjà complétée, elle peut seulement passer à « ${STATUTS.A_REFAIRE} ».`,
      hasMissingFields: false,
    };
  }
  const missing = getMissingFields(
    intervention.data,
    getRequiredFields(targetStatus, intervention),
  );
  if (!missing.length) return null;
  const items = missing.map((key) => `<li>${getFieldLabel(key)}</li>`).join("");
  return {
    text: `à compléter :<ul style="margin: 4px 0 0 0; padding-left: 18px;">${items}</ul>`,
    hasMissingFields: true,
  };
};

const getBlockedInterventions = (interventions, targetStatus) =>
  interventions
    .map((intervention) => ({
      intervention,
      reason: getBlockingReason(intervention, targetStatus),
    }))
    .filter(({ reason }) => reason);

const getBlockedMessageLines = (blocked) => {
  const lines = blocked.map(
    ({ intervention, reason }) =>
      `<b>Intervention ${intervention.number}</b> : ${reason.text}`,
  );
  if (!blocked.some(({ reason }) => reason.hasMissingFields)) return lines;
  return [
    ...lines,
    "<i>Complétez ces informations dans le formulaire de l'intervention, puis réessayez.</i>",
  ];
};

