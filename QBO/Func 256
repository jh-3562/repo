        "Herbes/Émondage",
        "Poubelle",
        "Drive",
        "Collant",
        "Graffiti",
        "Pression",
        "Autre",
      ])) ||
    (type === "Travaux" && isOneOf(cat, ["Dalle", "Finition"])) ||
    (type === "Déploiement" &&
      isOneOf(cat, ["Dalle", "Installation", "Finition"])) ||
    (notSpecial && type !== "Travaux saisonniers" && cat === "Diffuseur") ||
    isOneOf(cat, [
      "Verre",
      "Inox",
      "Braquette",
      "Banc",
      "Structure",
      "Vis",
      "Velcro",
      "Toit",
      "Affichage",
      "Désinstallation",
      "Sécurisation",
      "Conversion",
      "Nouveau Site",
      "Réinstallation",
      "Vandalisme",
      "Riveter Velcro",
      "Diffuseur anomalie",
      "Abribus absent",
      "Inaccessible",
      "Vis coincée",
      "Herbes",
      "Numéro",
    ]);

  rules.Photo_AbribusCompletLave =
    isOneOf(cat, [
      "Régulier - Supplémentaire",
      "Régulier - ÉTÉ",
      "Régulier - HIVER",
    ]) ||
    (type === "Entretien" && cat === "Régulier - NUM") ||
    (notSpecial &&
      isOneOf(cat, [
        "Herbes/Émondage",
        "Poubelle",
        "Drive",
        "Collant",
        "Graffiti",
        "Pression",
      ]));

  const isDeneigement =
    isOneOf(cat, ["Régulier", "Accès pub", "Déglaçage", "Mécanique"]) ||
    (type === "Déneigement" && isOneOf(cat, ["Dalle", "Plainte"]));
  rules.Photo_AbribusCompletDeneige = isDeneigement;
  rules.Photo_AbribusCompletDeneigeCoteOppose = isDeneigement;
