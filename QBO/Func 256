// -------------------- POPUPS --------------------
const createOrUpdateElement = (id, tag, style, innerHTML = "") => {
  let element = document.getElementById(id);
  if (!element) {
    element = document.createElement(tag);
    element.id = id;
    document.body.appendChild(element);
  }
  element.style = style;
  element.innerHTML = innerHTML;
  return element;
};

const showBanner = (id, message, color, icon) => {
  const banner = createOrUpdateElement(
    id,
    "div",
    `
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      min-width: 300px;
      height: 50px;
      background-color: white;
      color: black;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      border-radius: 5px;
      padding: 0 20px;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
    `,
    `
      <div style="margin-right: 10px; color: ${color};">${icon}</div><div>${message}</div>
      <div id="${id}Progress" style="position: absolute; bottom: 0; left: 0; background-color: ${color}; height: 5px; width: 0%;"></div>
    `,
  );
  const progress = document.getElementById(`${id}Progress`);
  let width = 0;
  const interval = setInterval(() => {
    if (width >= 100) {
      clearInterval(interval);
      banner.style.display = "none";
      return;
    }
    width++;
    progress.style.width = width + "%";
  }, 55);
};

