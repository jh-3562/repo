const pad2 = (n) => String(n).padStart(2, "0");

const nowLocalISO = () => {
  const d = new Date();
  return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}T${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}`;
};

const getDateCompletionAndYear = (dateHeureComplete) => {
  const v = String(dateHeureComplete || "").trim();
  if (!v) return { DateCompletion: "", AnneeCompletion: "" };
  const datePart = v.split("T")[0].split(" ")[0];
  const m = datePart.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return { DateCompletion: "", AnneeCompletion: "" };
  return {
    DateCompletion: `${m[1]}-${m[2]}-${m[3]}`,
    AnneeCompletion: m[1],
  };
};

const getCreationDateValidity = (data) =>
  data?.CommandDate && typeof isFutureDate === "function"
    ? isFutureDate(data.CommandDate)
    : "Non";

const putIntervention = async (formId, changedData, status, preventNotify) => {
  const body = {
    document: {
      documentID: formId,
      data: JSON.stringify(changedData),
      status,
      active: true,
      template: { templateId: INTERVENTION_TEMPLATE_ID },
    },
  };
  if (preventNotify) body.preventNotify = preventNotify;
  const response = await api({ local: true }).put("document", body);
  if (!response || response.status >= 300)
    throw new Error(`mise à jour refusée (statut ${response?.status})`);
};

const postJSON = async (url, body) => {
  try {
    const rep = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });
    return { ok: rep.ok, status: rep.status };
  } catch (e) {
    return { ok: false, status: 0 };
  }
};

