  rules.Photo_BraquetteInstallee = cat === "Braquette";

  const isReparation =
    isOneOf(cat, ["Banc", "Vis", "Velcro", "Toit", "Affichage"]) ||
    (type === "Réparation" &&
      isOneOf(cat, [
        "Autre",
        "Diffuseur",
        "Structure",
        "Verre Pub",
        "Verre",
      ])) ||
    (type === "Signalement" && cat === "Verre Pub");
  rules.Photo_AbribusCompletCoteReparation = isReparation;
  rules.Photo_PlanRaproccheReparation = isReparation;

  rules.Photo_SiteSansAbribus = cat === "Désinstallation";
  rules.Photo_SiteEnArrivant = cat === "Sécurisation";
  rules.Photo_SiteApresSecurisation = cat === "Sécurisation";

  const isInstallation =
    isOneOf(cat, ["Conversion", "Nouveau Site", "Réinstallation"]) ||
    (type === "Déploiement" && cat === "Installation");
  const isInstallationOuFinition =
    isInstallation ||
    (isOneOf(type, ["Déploiement", "Travaux"]) && cat === "Finition");
  rules.Photo_PlanEloigneAbribusCompletFaceInt = isInstallationOuFinition;
  rules.Photo_PlanEloigneAbribusCompletFaceExt = isInstallationOuFinition;
  rules.Photo_4BoulonsSecuriteToit = isInstallation;
  rules.Photo_NumSerieFABCO = isInstallation;

  rules.Photo_ProblemeAReparer =
    isOneOf(cat, [
      "Vandalisme",
      "Riveter Velcro",
      "Diffuseur anomalie",
      "Abribus absent",
      "Inaccessible",
      "Vis coincée",
    ]) ||
    (isOneOf(type, ["NO POST", "Signalement"]) && cat === "Autre") ||
    (type === "Signalement" && cat === "Structure");

  const isDeploiementNumerique = type === "Déploiement" && cat === "Numérique";
  const isInterventionNumerique = type === "Numérique" && cat === "Numérique";
  rules.Photo_GrosPlanFaceInt = isDeploiementNumerique;
