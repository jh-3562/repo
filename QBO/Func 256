    (type === "Travaux saisonniers" && cat === "Autre");
  rules.Photo_AbribusAvantIntervention = isAvantApres;
  rules.Photo_AbribusApresIntervention = isAvantApres;

  rules.Photo_AvantCoupeHerbe = cat === "Herbes";
  rules.Photo_AprèsCoupeHerbe = cat === "Herbes";

