/* HELPERS */
const showWarningPopup = (message) => {
  return new Promise((resolve) => {
    const overlay = createOrUpdateElement(
      "warningOverlay",
      "div",
      `
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
      `,
    );

    overlay.innerHTML = `
      <div style="
        background: white;
        padding: 25px;
        border-radius: 8px;
        width: 380px;
        text-align: center;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
      ">
        <div style="font-size: 16px; margin-bottom: 20px;">
          ${message}
        </div>

        <button id="warningPopupOk"
          style="
            background: #2ecc71;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
          ">
          OK
        </button>
      </div>
    `;

    const okBtn = document.getElementById("warningPopupOk");

    if (okBtn) {
      okBtn.onclick = () => {
        overlay.remove();
        resolve(true);
      };
    }
  });
};

const REDIRECT_DEMANDES_URL = "https://web.cat-gtm-test.fastercom.io/demandes";

const main = async () => {
  console.log("docData :", docData);

  const statusChamp = docData.TEMPORARY_STATUS;

  try {
    const demandeTemplateId = "dadaf75a-cd49-4cba-8060-2ac15155478f";

    const rawAutreEquipement = String(
      docData.Demande_TransportAutreEquipements || "",
    )
      .trim()
      .toLowerCase();

    console.log(
      "Valeur brute Demande_TransportAutreEquipements =",
      docData.Demande_TransportAutreEquipements,
    );

    console.log(
      "Valeur normalisée Demande_TransportAutreEquipements =",
      rawAutreEquipement,
    );

    const autreEquipement =
      docData.Demande_TransportAutreEquipements === true ||
      ["true", "oui", "1", "yes"].includes(rawAutreEquipement) ||
      rawAutreEquipement.includes("bonbonne") ||
      rawAutreEquipement.includes("oxyg");

    if (autreEquipement) {
      await showWarningPopup(
        "S'assurer que la bonbonne soit remplie pour le transport.",
      );
    }

    showPopupLoading("Création de la demande...");

    const demandeDoc = {
      data: formatDataAPI_FASTER(docData),
      status: "Draft",
      active: true,
      template: {
        templateId: demandeTemplateId,
      },
    };

    const demandeRes = await api({ local: true }).post("document", {
      document: demandeDoc,
      preventNotify: "FULL",
    });

    hidePopupLoading();

    console.log("Réponse création demande :", demandeRes);

    const savedDemandeId =
      demandeRes?.data?.id ||
      demandeRes?.data?.FORMID ||
      demandeRes?.data?.formId ||
      demandeRes?.id;

    const numeroDemande =
      demandeRes?.data?.number ||
      demandeRes?.data?.NUMBER ||
      demandeRes?.data?.Numero ||
      demandeRes?.data?.numero ||
      docData?.NUMBER ||
      "N/A";

    showSuccessBanner(`Demande #${numeroDemande} créée avec succès.`);

    if (String(statusChamp || "").toLowerCase() === "draft" && savedDemandeId) {
      setTimeout(() => {
        window.location.href = `${REDIRECT_DEMANDES_URL}/${encodeURIComponent(
          String(savedDemandeId),
        )}`;
      }, 10000);
    }

    return demandeRes;
  } catch (error) {
    console.error("Erreur :", error);
    hidePopupLoading();
    showErrorBanner("Erreur lors de la création de la demande.");
  }
};

return main();
