  const flattened = { ...(data || {}) };

  Object.keys(flattened).forEach((key) => {
    const value = flattened[key];
    if (!Array.isArray(value)) return;

    value.forEach((row, index) => {
      Object.keys(row || {}).forEach((subKey) => {
        flattened[`${subKey}|${index + 1}`] = row[subKey];
