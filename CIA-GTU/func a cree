      value: typeIdentification,
      type: "TEXT",
    },
  ];

  if (typeIdentification === "RAMQ") {
    filters.push({
      key: "Identite_RAMQ",
      operator: "EQUALS",
      value: numeroAssurance,
      type: "TEXT",
    });
  } else if (typeIdentification === "Carte santé d'une autre province") {
    filters.push({
      key: "Identite_NumeroAssuranceMaladie",
      operator: "EQUALS",
      value: numeroAssurance,
