const getMoisFromDate = (dateStr) => {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(dateStr || "").trim());
  if (!m) return null;
  const moisIndex = Number(m[2]) - 1;
  return MOIS_NOMS[moisIndex] || null;
};

