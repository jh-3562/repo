const getProvinceCode = (value) => {
  const raw = String(value || "")
    .trim()
    .toUpperCase();

  if (/^[A-Z]{2}$/.test(raw)) {
    return raw;
  }

  const match = raw.match(/\b[A-Z]{2}\b/);
